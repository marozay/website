---
import Layout from "../layouts/Layout.astro";
import DotGrid from "@/widgets/dot-grid.astro";
import Hero from "@/widgets/hero.astro";
import Section from "@/components/ui/section.astro";
import Story from "@/widgets/story.astro";
---

<Layout>
  <main class="relative min-h-screen pt-24">
    <div class="absolute inset-0">
      <DotGrid />
    </div>

    <Hero />

    <div class="relative mt-4 border-y border-border bg-background">
      <Section class="px-4 py-10 md:px-8 lg:px-12">
        <Story />
      </Section>
    </div>
  </main>
</Layout>
