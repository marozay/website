---
import { MoonIcon, SnowflakeIcon, SunIcon } from "@lucide/astro";
import GithubIcon from "@/components/icons/github.astro";
import TelegramIcon from "@/components/icons/telegram.astro";
---

<header
  id="site-header"
  class="group fixed inset-x-0 top-0 z-50 p-4 transition-[padding] ease-in-out data-inset:p-0"
>
  <div class="mx-auto max-w-376 rounded-lg border-2 border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] shadow-[0_4px_24px_#00000026] backdrop-blur-[20px] backdrop-saturate-[1.4] transition-all ease-in-out group-data-inset:max-w-full group-data-inset:rounded-none">
    <div class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-4">
      <SnowflakeIcon class="size-10 text-blue-900 dark:text-blue-500" />

      <div class="flex items-center gap-1">
        <a
          href="https://t.me/marozay"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Telegram"
          class="grid size-9 place-items-center rounded-full text-muted-foreground transition-colors hover:text-foreground"
        >
          <TelegramIcon class="size-5" />
        </a>
        <a
          href="https://github.com/marozay"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="grid size-9 place-items-center rounded-full text-muted-foreground transition-colors hover:text-foreground"
        >
          <GithubIcon class="size-5" />
        </a>

        <span class="mx-1 h-6 w-px bg-border" aria-hidden="true"></span>

        <button
          type="button"
          data-sw-theme-toggle
          aria-label="Toggle dark theme"
          class="group flex size-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
        >
          <MoonIcon class="size-4 group-data-[state=on]:hidden" data-theme-icon />
          <SunIcon class="hidden size-4 group-data-[state=on]:block" data-theme-icon />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import { initThemeController } from "@starwind-ui/astro/theme";

  const header = document.getElementById("site-header");
  if (header) {
    const syncInset = () => {
      header.toggleAttribute("data-inset", window.scrollY > 100);
    };
    syncInset();
    window.addEventListener("scroll", syncInset, { passive: true });
  }

  // Controller finds `[data-sw-theme-control]`, so the switch needs no own code.
  initThemeController();
</script>
