---
import Section from "@/components/ui/section.astro";
import { projects } from "@/lib/projects";
import { deriveStack, type StackItem } from "@/lib/stack";

const groups = deriveStack(projects);
const max = Math.max(1, ...groups.flatMap((group) => group.items.map((item) => item.count)));

const hint = (item: StackItem): string =>
  `${item.count} ${item.count === 1 ? "project" : "projects"}: ${item.via.join(", ")}`;

const width = (item: StackItem): string => `${((item.count / max) * 100).toFixed(1)}%`;
---

<Section class="relative px-4 py-10 md:px-8 lg:px-12">
  <h2 class="text-3xl font-semibold">Stack</h2>
  <p class="mt-3 max-w-2xl text-foreground/80">
    What I build with, grouped by layer. The bar shows how many projects each tool carried.
  </p>

  <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    {groups.map((group) => (
      <div class="border-border pt-6">
        <h3 class="text-sm font-medium tracking-[0.2em] text-muted-foreground uppercase">
          {group.label}
        </h3>

        <ul class="mt-6 flex flex-col gap-4">
          {group.items.map((item) => (
            <li class="group" title={hint(item)}>
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-lg">{item.name}</span>
                <span class="text-sm whitespace-nowrap text-muted-foreground">
                  {item.count} {item.count === 1 ? "project" : "projects"}
                </span>
              </div>
              <div class="mt-2 h-1 overflow-hidden rounded-full bg-border" aria-hidden="true">
                <span
                  class="block h-full rounded-full bg-primary/60 transition-colors group-hover:bg-primary"
                  style={`width:${width(item)}`}
                />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
