{
  "name": "website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "bun -b lefthook install",
    "typecheck": "bun -b tsc --noEmit --runExternalCode",
    "lint:fix": "bun -b oxlint --fix",
    "format": "bun -b oxfmt",
    "format:check": "bun -b oxfmt --check",
    "dev": "bun -b astro dev",
    "build": "bun -b astro build",
    "preview": "bun -b astro preview"
  },
  "dependencies": {
    "@lucide/astro": "^1.73.0",
    "@starwind-ui/astro": "1.5.0",
    "astro": "^7.4.12",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.1.0-dev.20261115.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
