---
import "./dot-grid.css";

export interface Props {
  /** Dot color at rest. Accepts any CSS color, including `var()`. */
  baseColor?: string;
  /** Dot color near pointer. Accepts any CSS color, including `var()`. */
  activeColor?: string;
  class?: string;
}

// Grid dots read as a pattern, so they take the grid token. Interaction
// accent takes the primary token.
const {
  baseColor = "var(--grid-color, var(--border, #e2e8f0))",
  activeColor = "var(--primary, #1d4ed8)",
  class: className,
} = Astro.props;
---

<div
  class:list={["dot-grid", className]}
  data-dot-grid
  data-base-color={baseColor}
  data-active-color={activeColor}
>
  <canvas class="dot-grid__canvas"></canvas>
</div>

<script>
  /**
   * Port of React Bits "DotGrid" with fixed "calm" preset. Intro and click
   * shock stay out: both add code and never pay off on a static background.
   */

  const DOT_SIZE = 5;
  const GAP = 18;
  const PROXIMITY = 140;
  const STRENGTH = 0.5;
  const BOUNCE = 0.3;
  const TENSION = 0.4;
  const RETURN_DURATION = 1.4;
  const SWELL = 0.4;
  const STRETCH = 0.2;
  const GLOW = 0.25;
  const FADE = 0.5;
  const OPACITY = 1;

  const VERTEX = `#version 300 es
precision highp float;

layout(location = 0) in vec2 aCorner;
layout(location = 1) in vec4 aMotion;
layout(location = 2) in float aEnergy;

uniform vec2 uResolution;
uniform float uSize;
uniform float uSwell;
uniform float uStretch;

out vec2 vLocal;
out vec2 vPoint;
out float vLength;
out float vRadius;
out float vEnergy;

void main() {
  float radius = 0.5 * uSize * (1.0 + uSwell * aEnergy);
  float speed = length(aMotion.zw);
  float angle = speed > 0.001 ? atan(aMotion.w, aMotion.z) : 0.0;
  float axis = floor(angle / 1.5707963 + 0.5) * 1.5707963;
  angle = axis + (angle - axis) * smoothstep(8.0, 70.0, speed);
  vec2 dir = vec2(cos(angle), sin(angle));
  float halfLength = min(uSize * 2.0, speed * uStretch * 0.02);
  float pad = radius + 2.0;
  vec2 local = aCorner * vec2(halfLength + pad, pad);
  vec2 point = aMotion.xy + dir * local.x + vec2(-dir.y, dir.x) * local.y;
  vLocal = local;
  vPoint = point;
  vLength = halfLength;
  vRadius = radius;
  vEnergy = aEnergy;
  vec2 clip = point / uResolution * 2.0 - 1.0;
  gl_Position = vec4(clip.x, -clip.y, 0.0, 1.0);
}
`;

  const FRAGMENT = `#version 300 es
precision highp float;

in vec2 vLocal;
in vec2 vPoint;
in float vLength;
in float vRadius;
in float vEnergy;

uniform vec2 uResolution;
uniform vec3 uBase;
uniform vec3 uActive;
uniform float uGlow;
uniform float uOpacity;
uniform float uFade;

out vec4 outColor;

float smootherstep01(float t) {
  t = clamp(t, 0.0, 1.0);
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

void main() {
  float d = length(vec2(max(abs(vLocal.x) - vLength, 0.0), vLocal.y)) - vRadius;
  float aa = max(fwidth(d), 0.0001);
  float body = clamp(0.5 - d / aa, 0.0, 1.0);
  float halo = uGlow * vEnergy * 0.5 * exp(-max(d, 0.0) / max(vRadius * 1.3, 0.6));
  float alpha = body + (1.0 - body) * halo;
  vec3 color = mix(uBase, uActive, clamp(vEnergy * 1.2, 0.0, 1.0));
  float fade = 1.0;
  if (uFade > 0.0) {
    vec2 edge = min(vPoint, uResolution - vPoint) / (uFade * 0.4 * min(uResolution.x, uResolution.y));
    fade = smootherstep01(edge.x) * smootherstep01(edge.y);
  }
  alpha *= uOpacity * fade;
  outColor = vec4(color * alpha, alpha);
}
`;

  type Rgb = [number, number, number];

  const colorCanvas = document.createElement("canvas");
  colorCanvas.width = 1;
  colorCanvas.height = 1;
  const colorCtx = colorCanvas.getContext("2d", { willReadFrequently: true });

  /** Resolve `var()` chains and `color()` syntax to a concrete `color` value. */
  const toComputed = (host: HTMLElement, value: string): string => {
    const probe = document.createElement("span");
    probe.style.cssText = `display:none;color:${value}`;
    host.appendChild(probe);
    const computed = getComputedStyle(probe).color;
    probe.remove();
    return computed;
  };

  /** Composite `top` over `bottom` and return sRGB floats. */
  const flatten = (top: string, bottom: string): Rgb => {
    if (!colorCtx) return [1, 1, 1];
    colorCtx.clearRect(0, 0, 1, 1);
    colorCtx.fillStyle = bottom;
    colorCtx.fillRect(0, 0, 1, 1);
    colorCtx.fillStyle = top;
    colorCtx.fillRect(0, 0, 1, 1);
    const data = colorCtx.getImageData(0, 0, 1, 1).data;
    return [(data[0] ?? 0) / 255, (data[1] ?? 0) / 255, (data[2] ?? 0) / 255];
  };

  const smootherstep = (value: number): number => {
    const x = Math.min(1, Math.max(0, value));
    return x * x * x * (x * (x * 6 - 15) + 10);
  };

  const compileShader = (gl: WebGL2RenderingContext, type: number, source: string): WebGLShader => {
    const shader = gl.createShader(type);
    if (!shader) throw new Error("dot-grid: shader allocation failed");
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    return shader;
  };

  const init = (root: HTMLElement): void => {
    const canvas = root.querySelector<HTMLCanvasElement>(".dot-grid__canvas");
    if (!canvas) return;

    const gl = canvas.getContext("webgl2", {
      alpha: true,
      premultipliedAlpha: true,
      antialias: false,
    });
    if (!gl) return;

    const program = gl.createProgram();
    if (!program) return;
    try {
      gl.attachShader(program, compileShader(gl, gl.VERTEX_SHADER, VERTEX));
      gl.attachShader(program, compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT));
    } catch {
      return;
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;

    const uniform = (name: string) => gl.getUniformLocation(program, name);
    const uniforms = {
      resolution: uniform("uResolution"),
      size: uniform("uSize"),
      swell: uniform("uSwell"),
      stretch: uniform("uStretch"),
      base: uniform("uBase"),
      active: uniform("uActive"),
      glow: uniform("uGlow"),
      opacity: uniform("uOpacity"),
      fade: uniform("uFade"),
    };

    const baseSource = root.dataset.baseColor ?? "var(--grid-color, var(--border, #e2e8f0))";
    const activeSource = root.dataset.activeColor ?? "var(--primary, #1d4ed8)";
    let base: Rgb = [1, 1, 1];
    let active: Rgb = [1, 1, 1];

    // Tokens change with the theme, so colors resolve again after a theme swap.
    const applyPalette = (): void => {
      const background = toComputed(root, "var(--background, #f8fafc)");
      base = flatten(toComputed(root, baseSource), background);
      active = flatten(toComputed(root, activeSource), background);
    };

    const vao = gl.createVertexArray();
    const cornerBuffer = gl.createBuffer();
    const instanceBuffer = gl.createBuffer();
    if (!vao || !cornerBuffer || !instanceBuffer) return;

    gl.bindVertexArray(vao);
    gl.bindBuffer(gl.ARRAY_BUFFER, cornerBuffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ARRAY_BUFFER, instanceBuffer);
    gl.enableVertexAttribArray(1);
    gl.vertexAttribPointer(1, 4, gl.FLOAT, false, 20, 0);
    gl.vertexAttribDivisor(1, 1);
    gl.enableVertexAttribArray(2);
    gl.vertexAttribPointer(2, 1, gl.FLOAT, false, 20, 16);
    gl.vertexAttribDivisor(2, 1);
    gl.bindVertexArray(null);

    // Coarse pointer means touch or a TV remote: no cursor, no interaction.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const coarse = window.matchMedia("(pointer: coarse)").matches;
    const interactive = !reduced && !coarse;

    const view = { width: 0, height: 0, ratio: 1 };
    const grid = { count: 0, cols: 1, rows: 1, cell: 1 };
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, time: 0, inside: false, presence: 0 };

    let rest = new Float32Array(0);
    let offset = new Float32Array(0);
    let velocity = new Float32Array(0);
    let force = new Float32Array(0);
    let next = new Float32Array(0);
    let energy = new Float32Array(0);
    let instances = new Float32Array(0);

    let visible = true;
    let raf = 0;
    let last = 0;

    const rebuild = (): void => {
      const cell = Math.max(2, DOT_SIZE + GAP);
      const cols = Math.max(1, Math.floor((view.width + GAP) / cell));
      const rows = Math.max(1, Math.floor((view.height + GAP) / cell));
      const startX = (view.width - (cols * cell - GAP)) / 2 + DOT_SIZE / 2;
      const startY = (view.height - (rows * cell - GAP)) / 2 + DOT_SIZE / 2;
      const count = cols * rows;

      Object.assign(grid, { count, cols, rows, cell });
      rest = new Float32Array(count * 2);
      offset = new Float32Array(count * 2);
      velocity = new Float32Array(count * 2);
      force = new Float32Array(count * 2);
      next = new Float32Array(count * 2);
      energy = new Float32Array(count);
      instances = new Float32Array(count * 5);

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const index = (row * cols + col) * 2;
          rest[index] = startX + col * cell;
          rest[index + 1] = startY + row * cell;
        }
      }

      gl.bindBuffer(gl.ARRAY_BUFFER, instanceBuffer);
      gl.bufferData(gl.ARRAY_BUFFER, instances.byteLength, gl.DYNAMIC_DRAW);
    };

    const render = (): void => {
      for (let i = 0; i < grid.count; i++) {
        const index = i * 2;
        const target = i * 5;
        const x = rest[index] + offset[index];
        const y = rest[index + 1] + offset[index + 1];
        let glowing = energy[i];
        if (interactive && pointer.presence > 0.001) {
          const distance = Math.hypot(x - pointer.x, y - pointer.y);
          if (distance < PROXIMITY) {
            glowing = Math.max(
              glowing,
              smootherstep(1 - distance / PROXIMITY) * 0.4 * pointer.presence,
            );
          }
        }
        instances[target] = x;
        instances[target + 1] = y;
        instances[target + 2] = velocity[index];
        instances[target + 3] = velocity[index + 1];
        instances[target + 4] = glowing;
      }

      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
      gl.useProgram(program);
      gl.uniform2f(uniforms.resolution, view.width, view.height);
      gl.uniform1f(uniforms.size, DOT_SIZE);
      gl.uniform1f(uniforms.swell, SWELL);
      gl.uniform1f(uniforms.stretch, STRETCH);
      gl.uniform1f(uniforms.glow, GLOW);
      gl.uniform3f(uniforms.base, base[0], base[1], base[2]);
      gl.uniform3f(uniforms.active, active[0], active[1], active[2]);
      gl.uniform1f(uniforms.opacity, OPACITY);
      gl.uniform1f(uniforms.fade, FADE);
      gl.bindVertexArray(vao);
      gl.bindBuffer(gl.ARRAY_BUFFER, instanceBuffer);
      gl.bufferSubData(gl.ARRAY_BUFFER, 0, instances);
      gl.drawArraysInstanced(gl.TRIANGLE_STRIP, 0, 4, grid.count);
      gl.bindVertexArray(null);
    };

    const step = (dt: number): void => {
      const zeta = 1 - 0.85 * BOUNCE;
      const omega = 4 / (zeta * RETURN_DURATION);
      const stiffness = omega * omega;
      const damping = 2 * zeta * omega;
      const speed = Math.hypot(pointer.vx, pointer.vy);
      const drive = pointer.inside ? 6500 * Math.tanh(speed / 900) * STRENGTH : 0;
      const dirX = speed > 0.001 ? pointer.vx / speed : 0;
      const dirY = speed > 0.001 ? pointer.vy / speed : 0;
      const coupling = (TENSION * 900) ** 2 / (grid.cell * grid.cell);
      const viscosity = Math.sqrt(coupling) * 0.06;
      const limit = Math.sqrt(stiffness + 8 * coupling) + damping + 8 * viscosity;
      const steps = Math.min(24, Math.max(1, Math.ceil(dt / Math.min(1 / 120, 1.2 / limit))));
      const h = dt / steps;

      for (let i = 0; i < grid.count; i++) {
        const index = i * 2;
        const rx = rest[index];
        const ry = rest[index + 1];
        let ax = 0;
        let ay = 0;
        if (drive > 0) {
          const ex = rx + offset[index] - pointer.x;
          const ey = ry + offset[index + 1] - pointer.y;
          const distance = Math.hypot(ex, ey);
          if (distance < PROXIMITY) {
            const weight = smootherstep(1 - distance / PROXIMITY) * drive;
            ax += weight * (dirX + (distance > 0.001 ? (ex / distance) * 0.6 : 0));
            ay += weight * (dirY + (distance > 0.001 ? (ey / distance) * 0.6 : 0));
          }
        }
        force[index] = ax;
        force[index + 1] = ay;
      }

      const { cols, rows } = grid;
      const stride = cols * 2;
      for (let n = 0; n < steps; n++) {
        for (let row = 0; row < rows; row++) {
          for (let col = 0; col < cols; col++) {
            const index = (row * cols + col) * 2;
            let ax = force[index] - stiffness * offset[index] - damping * velocity[index];
            let ay =
              force[index + 1] - stiffness * offset[index + 1] - damping * velocity[index + 1];
            if (coupling > 0) {
              let lx = -4 * offset[index];
              let ly = -4 * offset[index + 1];
              let mx = -4 * velocity[index];
              let my = -4 * velocity[index + 1];
              if (col > 0) {
                lx += offset[index - 2];
                ly += offset[index - 1];
                mx += velocity[index - 2];
                my += velocity[index - 1];
              }
              if (col < cols - 1) {
                lx += offset[index + 2];
                ly += offset[index + 3];
                mx += velocity[index + 2];
                my += velocity[index + 3];
              }
              if (row > 0) {
                lx += offset[index - stride];
                ly += offset[index - stride + 1];
                mx += velocity[index - stride];
                my += velocity[index - stride + 1];
              }
              if (row < rows - 1) {
                lx += offset[index + stride];
                ly += offset[index + stride + 1];
                mx += velocity[index + stride];
                my += velocity[index + stride + 1];
              }
              ax += coupling * lx + viscosity * mx;
              ay += coupling * ly + viscosity * my;
            }
            next[index] = velocity[index] + ax * h;
            next[index + 1] = velocity[index + 1] + ay * h;
          }
        }
        for (let i = 0; i < offset.length; i++) {
          velocity[i] = next[i]!;
          offset[i]! += velocity[i]! * h;
        }
      }

      for (let i = 0; i < grid.count; i++) {
        const index = i * 2;
        energy[i] = Math.min(
          1,
          (Math.hypot(velocity[index]!, velocity[index + 1]!) / 380) * 0.85 +
            (Math.hypot(offset[index]!, offset[index + 1]!) / (grid.cell * 2.2)) * 0.35,
        );
      }

      const decay = 1 - Math.exp(-dt / 0.08);
      pointer.vx -= pointer.vx * decay;
      pointer.vy -= pointer.vy * decay;
      const presenceTarget = pointer.inside ? 1 : 0;
      pointer.presence += (presenceTarget - pointer.presence) * (1 - Math.exp(-dt / 0.2));
    };

    const settled = (): boolean => {
      if (Math.abs(pointer.vx) + Math.abs(pointer.vy) > 1) return false;
      const presenceTarget = pointer.inside ? 1 : 0;
      if (Math.abs(presenceTarget - pointer.presence) > 0.002) return false;
      for (let i = 0; i < offset.length; i++) {
        if (Math.abs(offset[i]!) > 0.02 || Math.abs(velocity[i]!) > 0.5) return false;
      }
      return true;
    };

    const frame = (now: number): void => {
      raf = 0;
      if (!visible) return;
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      step(dt);
      render();
      if (!settled()) raf = requestAnimationFrame(frame);
    };

    /** Start a frame only on demand; a settled grid costs nothing. */
    const wake = (): void => {
      if (raf || !visible) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };

    const resize = (): void => {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.max(1, Math.round(rect.width));
      const height = Math.max(1, Math.round(rect.height));
      if (width === view.width && height === view.height && ratio === view.ratio) return;
      Object.assign(view, { width, height, ratio });
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      rebuild();
      render();
    };

    if (interactive) {
      const onMove = (event: PointerEvent): void => {
        if (event.pointerType === "touch") return;
        const rect = canvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const inside = x >= 0 && y >= 0 && x <= view.width && y <= view.height;
        const time = event.timeStamp || performance.now();
        if (inside && pointer.inside && pointer.time) {
          const elapsed = Math.max(4, time - pointer.time) / 1000;
          pointer.vx += ((x - pointer.x) / elapsed - pointer.vx) * 0.6;
          pointer.vy += ((y - pointer.y) / elapsed - pointer.vy) * 0.6;
        } else {
          pointer.vx = 0;
          pointer.vy = 0;
        }
        pointer.x = x;
        pointer.y = y;
        pointer.time = time;
        pointer.inside = inside;
        if (inside) wake();
      };

      const onLeave = (): void => {
        pointer.inside = false;
        pointer.time = 0;
        wake();
      };

      const onOut = (event: PointerEvent): void => {
        if (!event.relatedTarget) onLeave();
      };

      window.addEventListener("pointermove", onMove, { passive: true });
      window.addEventListener("pointerout", onOut);
      window.addEventListener("blur", onLeave);

      const visibility = new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? false;
        if (visible) wake();
      });
      visibility.observe(canvas);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
          raf = 0;
        } else {
          wake();
        }
      });
    }

    new ResizeObserver(() => {
      resize();
      wake();
    }).observe(canvas);

    new MutationObserver(() => {
      applyPalette();
      render();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "style", "data-theme"],
    });

    applyPalette();
    resize();
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-dot-grid]")) {
    if (root.dataset.dotGridReady === "true") continue;
    root.dataset.dotGridReady = "true";
    init(root);
  }
</script>
