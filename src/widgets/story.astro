---
import { formatDate, formatDuration, projects, toIsoDate } from "@/lib/projects";
---

<h2 class="text-3xl font-semibold">Story</h2>

<ul class="relative mt-10 flex flex-col gap-4 py-6 before:absolute before:top-0 before:left-2 before:block before:h-full before:w-px before:bg-[linear-gradient(to_bottom,transparent,var(--border)_2.5rem,var(--border)_calc(100%-2.5rem),transparent)] md:before:left-1/2 md:before:-translate-x-1/2">
  {projects.map((project) => (
    <li
      data-story-item
      class="relative flex justify-end pl-8 opacity-0 transition translate-y-16 duration-300 ease-out data-visible:translate-y-0 data-visible:opacity-100 md:justify-start md:pl-[unset] md:even:justify-end before:absolute before:top-7 before:left-0 before:block before:h-px before:w-1/2 before:bg-border md:even:before:left-1/2 after:absolute after:top-5 after:left-0 after:block after:size-4 after:rounded-full after:border-2 after:border-border after:bg-background after:outline-4 after:outline-background md:after:left-1/2 md:after:-translate-x-1/2"
    >
      <div class="relative w-full rounded-lg border border-border bg-surface shadow-md md:w-[calc(50%-1.5rem)]">
        <article class="p-4">
          <time datetime={toIsoDate(project.start)} class="text-xs text-muted-foreground">
            {formatDate(project.start)} - {project.end ? formatDate(project.end) : "Now"} (
            {formatDuration(project.start, project.end ?? undefined)})
          </time>
          <h3 class="mt-2 text-2xl">
            {project.title}, {project.job}{" "}
          </h3>
          <p class="mt-3 text-foreground/80" set:html={project.description} />
        </article>

        <div class="border-t border-border">
          <span class="-mt-2 ml-2 block w-fit bg-surface px-2 text-xs text-muted-foreground">
            Tech stack
          </span>
          <div class="flex flex-wrap gap-2 p-4 pt-3">
            {project.stack.map((item) => (
              <div class="w-fit rounded-sm border border-border bg-surface px-2 py-1 text-sm shadow-sm">
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </li>
  ))}
</ul>

<script>
  const setup = (): void => {
    const items = [...document.querySelectorAll<HTMLElement>("[data-story-item]")].filter(
      (item) => item.dataset.revealReady !== "true",
    );
    if (!items.length) return;

    for (const item of items) item.dataset.revealReady = "true";

    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !("IntersectionObserver" in window)
    ) {
      for (const item of items) item.setAttribute("data-visible", "");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute("data-visible", "");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.3 },
    );

    for (const item of items) observer.observe(item);
  };

  document.addEventListener("astro:page-load", setup);
  setup();
</script>
