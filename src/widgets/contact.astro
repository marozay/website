---
import Section from "@/components/ui/section.astro";

const email = "hello@marozay.dev";

const links = [
  { label: "Telegram", href: "https://t.me/marozay", meta: "Fastest reply", external: true },
  {
    label: "GitHub",
    href: "https://github.com/marozay",
    meta: "Code and projects",
    external: true,
  },
];
---

<Section
  id="contact"
  class="relative flex min-h-[70vh] scroll-mt-24 flex-col justify-between px-4 py-10 md:px-8 lg:px-12"
>
  <div>
    <h2 class="text-3xl font-semibold">Contact</h2>
    <p class="mt-3 max-w-2xl text-foreground/80">
      Not looking for full-time roles. Open to consulting, code reviews and interesting side
      projects.
    </p>
  </div>

  <ul class="mt-12 flex flex-col">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer noopener"
          class="group flex items-baseline justify-between gap-4 border-b border-border py-6 transition-colors hover:border-primary"
        >
          <span class="text-2xl">{link.label}</span>
          <span class="flex items-baseline gap-4 text-sm text-muted-foreground">
            {link.meta}
            <span
              aria-hidden="true"
              class="text-lg transition-transform group-hover:-translate-y-0.5"
            >
              ↗
            </span>
          </span>
        </a>
      </li>
    ))}

    <li>
      <div class="group flex items-center justify-between gap-4 border-b border-border py-6 transition-colors hover:border-primary">
        <a href={`mailto:${email}`} class="flex flex-1 items-baseline justify-between gap-4">
          <span class="text-2xl">Email</span>
          <span class="text-sm text-muted-foreground">{email}</span>
        </a>
        <button
          type="button"
          data-copy-email
          data-email={email}
          class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary"
        >
          Copy
        </button>
        <span data-copy-status role="status" aria-live="polite" class="sr-only"></span>
      </div>
    </li>
  </ul>

  <p class="mt-12 text-sm text-muted-foreground">
    Remote, UTC+3 · local time{" "}
    <span data-local-time class="tabular-nums text-foreground/70">
      --:--
    </span>
  </p>
</Section>

<script>
  const setupCopy = (): void => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-email]")) {
      if (button.dataset.copyReady === "true") continue;
      button.dataset.copyReady = "true";

      button.addEventListener("click", async () => {
        const email = button.dataset.email ?? "";
        const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
        const label = button.textContent ?? "Copy";

        try {
          await navigator.clipboard.writeText(email);
          button.textContent = "Copied";
          if (status) status.textContent = "Email copied";
        } catch {
          button.textContent = "Press Ctrl+C";
          if (status) status.textContent = "Copy failed";
        }

        window.setTimeout(() => {
          button.textContent = label;
          if (status) status.textContent = "";
        }, 2000);
      });
    }
  };

  let clockStarted = false;

  /** Local time for UTC+3, refreshed every half minute. */
  const setupClock = (): void => {
    const nodes = document.querySelectorAll<HTMLElement>("[data-local-time]");
    if (nodes.length === 0) return;

    const render = (): void => {
      const shifted = new Date(Date.now() + 3 * 60 * 60 * 1000);
      const hours = String(shifted.getUTCHours()).padStart(2, "0");
      const minutes = String(shifted.getUTCMinutes()).padStart(2, "0");
      for (const node of nodes) node.textContent = `${hours}:${minutes}`;
    };

    render();
    if (clockStarted) return;
    clockStarted = true;
    window.setInterval(render, 30000);
  };

  const setup = (): void => {
    setupCopy();
    setupClock();
  };

  document.addEventListener("astro:page-load", setup);
  setup();
</script>
