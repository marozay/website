---
import "@/components/global.css";
import { Font, getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import Header from "@/widgets/header.astro";
import noise from "@/assets/white-noise.webp";

// In this case (grain texture) AVIF reduces image weight
const grain = await getImage({
  src: noise,
  width: 512,
  height: 512,
  fit: "cover",
  format: "avif",
  quality: 50,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <ThemeInitScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <title>Egor Morozov | Fullstack Developer</title>
  </head>

  <body style={`--grain-image: url('${grain.src}')`}>
    <Header />
    <slot />
  </body>
</html>
