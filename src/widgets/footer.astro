---
import { SnowflakeIcon } from "@lucide/astro";

const email = "hello@marozay.dev";
const year = new Date().getFullYear();

const sections = [
  { label: "Story", href: "#story" },
  { label: "Stack", href: "#stack" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];

const elsewhere = [
  { label: "Telegram", href: "https://t.me/marozay", external: true },
  { label: "GitHub", href: "https://github.com/marozay", external: true },
  { label: "Email", href: `mailto:${email}`, external: false },
];
---

<footer class="surface-grain relative mt-4 border-t border-border bg-background">
  <div class="mx-auto w-full max-w-screen-2xl px-4 py-10 md:px-8 lg:px-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <SnowflakeIcon class="size-8 text-blue-900 dark:text-blue-500" />
          <span class="text-sm font-semibold tracking-[0.2em] uppercase">MAROZAY</span>
        </div>
        <p class="mt-3 text-sm text-foreground/70">Fullstack Developer</p>
      </div>

      <nav aria-label="Sections">
        <h2 class="text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase">
          Sections
        </h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {sections.map((section) => (
            <li>
              <a
                href={section.href}
                class="text-foreground/70 transition-colors hover:text-foreground"
              >
                {section.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <h2 class="text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase">
          Elsewhere
        </h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer noopener" : undefined}
                class="text-foreground/70 transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-foreground/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Egor Morozov</p>
      <p>
        Built with Astro ·{" "}
        <a
          href="https://github.com/marozay/website"
          target="_blank"
          rel="noreferrer noopener"
          class="transition-colors hover:text-foreground"
        >
          Source ↗
        </a>
      </p>
    </div>
  </div>
</footer>
