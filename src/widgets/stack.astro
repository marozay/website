---
import Section from "@/components/ui/section.astro";
import { getGroupedTechnologyStats } from "@/data/projects";
import type { TechnologyType } from "@/data/technologies.types";

const TYPE_LABELS: Record<TechnologyType, string> = {
  frontend: "Frontend",
  backend: "Backend",
  "data-and-ai": "Data & AI",
};

const groups = getGroupedTechnologyStats().map((group) => ({
  label: TYPE_LABELS[group.technologyType],
  items: [...group.technologies].sort((a, b) => b.projectsCount - a.projectsCount),
}));

const max = Math.max(
  1,
  ...groups.flatMap((group) => group.items.map((item) => item.projectsCount)),
);

const width = (count: number): string => `${((count / max) * 100).toFixed(1)}%`;
---

<Section class="relative px-4 py-10 md:px-8 lg:px-12">
  <h2 class="text-3xl font-semibold">Stack</h2>
  <p class="mt-3 max-w-2xl text-foreground/80">
    What I build with, grouped by layer. The bar shows how many projects each tool carried.
  </p>

  <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    {groups.map((group) => (
      <div class="border-t border-border pt-6">
        <h3 class="text-sm font-medium tracking-[0.2em] text-muted-foreground uppercase">
          {group.label}
        </h3>

        <ul class="mt-6 flex flex-col gap-4">
          {group.items.map((item) => (
            <li class="group" title={item.technology.description}>
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-lg">{item.technology.title}</span>
                <span class="text-sm whitespace-nowrap text-muted-foreground">
                  {item.projectsCount} {item.projectsCount === 1 ? "project" : "projects"}
                </span>
              </div>
              <div class="mt-2 h-1 overflow-hidden rounded-full bg-border" aria-hidden="true">
                <span
                  class="block h-full rounded-full bg-primary/60 transition-colors group-hover:bg-primary"
                  style={`width:${width(item.projectsCount)}`}
                />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
