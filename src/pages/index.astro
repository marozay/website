---
import Layout from "../layouts/Layout.astro";
import DotGrid from "@/widgets/dot-grid.astro";
import Hero from "@/widgets/hero.astro";
import Section from "@/components/ui/section.astro";
import Story from "@/widgets/story.astro";
import Stack from "@/widgets/stack.astro";
import About from "@/widgets/about.astro";
import Contact from "@/widgets/contact.astro";
import Footer from "@/widgets/footer.astro";
---

<Layout>
  <main class="relative min-h-screen pt-24">
    <div class="absolute inset-0">
      <DotGrid />
    </div>

    <Hero />

    <div id="story" class="relative mt-4 scroll-mt-24 border-y border-border bg-background">
      <Section class="px-4 py-10 md:px-8 lg:px-12">
        <Story />
      </Section>
    </div>

    <Stack />

    <div id="about" class="relative mt-4 scroll-mt-24 border-y border-border bg-background">
      <About />
    </div>

    <Contact />
  </main>

  <Footer />
</Layout>
